{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "before 6am on monday"
  ],
  "prCreation": "status-success",
  "semanticCommitType": "fix",
  "semanticCommitScope": "deps",
  "labels": [
    "dependencies"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on the first day of the month"
    ]
  },
  "packageRules": [
    {
      "description": "Small updates merge themselves once CI is green",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "lockFileMaintenance"
      ],
      "automerge": true
    },
    {
      "description": "Major updates wait for a human",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "labels": [
        "dependencies",
        "major"
      ]
    },
    {
      "description": "npm and Rust parts of Tauri must stay in step",
      "groupName": "Tauri",
      "matchPackageNames": [
        "@tauri-apps/**",
        "tauri",
        "tauri-build",
        "tauri-plugin-*"
      ]
    },
    {
      "groupName": "Svelte",
      "matchPackageNames": [
        "svelte",
        "svelte-check",
        "@sveltejs/**",
        "@tsconfig/svelte"
      ]
    },
    {
      "description": "Workflow updates do not need a new app release",
      "matchManagers": [
        "github-actions"
      ],
      "semanticCommitType": "ci",
      "semanticCommitScope": null
    },
    {
      "description": "Release builds stay on an older Ubuntu so the binary and .deb run on more distributions",
      "matchFileNames": [
        ".github/workflows/release.yml"
      ],
      "matchDepNames": [
        "ubuntu"
      ],
      "enabled": false
    }
  ]
}
