{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SvcDeck",
  "mainBinaryName": "svcdeck",
  "version": "0.1.0",
  "identifier": "io.github.bl4z3_0o.SvcDeck",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SvcDeck",
        "width": 440,
        "height": 380,
        "minWidth": 300,
        "minHeight": 220,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "shadow": false,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Start, stop and open your services",
    "license": "GPL-3.0-or-later",
    "category": "Utility"
  }
}
